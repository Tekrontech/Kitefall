* text=auto

# Unity YAML – let Git merge them as text
*.unity      text eol=lf merge=unityyamlmerge
*.prefab     text eol=lf merge=unityyamlmerge
*.asset      text eol=lf merge=unityyamlmerge
*.mat        text eol=lf merge=unityyamlmerge
*.meta       text eol=lf
*.cs         text diff=csharp
*.asmdef     text eol=lf
*.md         text

# Binary
*.png  binary
*.jpg  binary
*.psd  binary
*.fbx  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
